authority "com.acme.bitcoin.transfer.reviewed" {
    version = "1.0.0"
    intent = "bitcoin.transaction"

    config {
        network = "MAINNET"
    }

    approver treasury {
        type = "public-key"
        id = "treasury-manager"
        algorithm = "ED25519"
        publicKey64 = "11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo="
    }

    approver compliance {
        type = "reference"
        id = "compliance-officer"
        ref = "users/compliance-officer"
    }

    let recipientAddress = "1BoatSLRHtKNngkdXEeobR76b53LETtpyT"
    let changeAddress = "1KFHE7w8BhaENAswwryaoccDb6qcT6DbYY"
    let recipientSatoshis = 100000
    let maxFeeSatoshis = 1000
    let automaticFeeSatoshis = 500

    policy "bitcoin-payment-with-review" {
        default deny

        let validPayment = when {
            network == "MAINNET"
            signing.single
            sighash.all
            not sighash.anyoneCanPay
            effects.all(e -> e.type in ["utxo.spend", "utxo.output", "utxo.fee"])
            outputs.count() >= 1
            outputs.count() <= 2
            outputs.count(o -> o.address == recipientAddress) == 1
            outputs.all(o ->
                (o.address == recipientAddress and o.amount == recipientSatoshis)
                    or o.address == changeAddress
            )
            fee <= maxFeeSatoshis
        }

        allow if (validPayment)

        require 2 of [treasury, compliance] if (fee > automaticFeeSatoshis)
    }
}
