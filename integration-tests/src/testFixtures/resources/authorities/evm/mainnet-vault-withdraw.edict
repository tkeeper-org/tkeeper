authority "test:evm/mainnet-vault-withdraw" {
    intent = "evm.transaction"
    version = "1.0.0"
    title = "Mainnet vault withdraw"

    config {
        chainId = 1
    }

    contract vault: evm {
        address = "0x6666666666666666666666666666666666666666"
        fn withdraw(to: address, amount: uint256)
    }


    policy "test-evm-mainnet-vault-withdraw" {
        allow "allow-vault-withdraw" when {
            transaction.chainId == 1
            transaction.value == 0
            vault.withdraw.to == "0x7777777777777777777777777777777777777777"
            vault.withdraw.amount <= 55
        }
    }
}
